# --- API (apps/api) — copy to repo root `.env` for docker-compose / Dokploy ---
# Database
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_NAME=
# DATABASE_SSL=true

# API
# API_PORT=4500
# CORS_ORIGINS=http://localhost:7000,http://localhost:6500

# JWT
# JWT_SECRET=
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=
# JWT_REFRESH_EXPIRES_IN=7d

# S3 (uploads)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET_NAME=

# Outbound mail (MailerSend / SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=
# SMTP_FROM_NAME=

# Daily career digest (06:00 UTC). Optional override for recipient.
# DIGEST_TO=contact@ahmadcodes.com

# Inbound mail: shared secret for POST /mail/inbound (header X-Inbound-Secret).
# Generate a long random string; use the SAME value in the Cloudflare Email Worker secret.
INBOUND_MAIL_SECRET=

# --- Web / CMS (see apps/cms/.env.example for CMS-only vars) ---
# NEXT_PUBLIC_API_URL=
# VITE_API_URL=
