{
  "name": "ahmadcodes.com.turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "resume:build": "./resume/build.sh",
    "resume:build:previews": "./resume/build.sh --previews",
    "applications:build": "./resume/build.sh --with-applications"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
